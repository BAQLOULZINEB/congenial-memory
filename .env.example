EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Critical review generation: any OpenAI-compatible Chat Completions endpoint.
# Default: Groq (free key at https://console.groq.com/keys).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# Local alternative (no key, nothing leaves the machine): Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# SQLite file. Default: data/talentmatch.sqlite3 locally, /tmp/talentmatch.sqlite3 on Vercel.
# DATABASE_PATH=data/talentmatch.sqlite3
# JWT signing secret (required on Vercel, 32+ random characters). Locally a key is generated
# automatically in data/ when left empty.
JWT_SECRET=
# Create the demo account (demo@talentmatch.test / TalentMatch-Demo-2026) and its example report.
DEMO_SEED=true
# React uses same-origin /api routes. Development Vite proxies them to port 8000.
