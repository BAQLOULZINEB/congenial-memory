EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Local OpenAI-compatible service, e.g. Ollama. No documents sent without UI opt-in.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
DATABASE_PATH=data/talentmatch.sqlite3
# React uses same-origin /api routes. Development Vite proxies them to port 8000.
